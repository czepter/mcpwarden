{
  "name": "mcpwarden",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "env:init": "sh scripts/init-env.sh",
    "test": "vitest run -c tests/vitest.config.ts",
    "test:container": "vitest run -c tests/vitest.container.config.ts",
    "test:compose": "sh tests/e2e/compose-smoke.sh",
    "test:slim": "sh tests/e2e/slim-smoke.sh",
    "smoke": "tsx tests/smoke/run.ts",
    "test:unit": "vitest run -c tests/vitest.config.ts --project unit",
    "test:int": "vitest run -c tests/vitest.config.ts --project integration",
    "db:schema": "sh scripts/gen-auth-schema.sh",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "test:pg": "docker compose -p ${TEST_PG_PROJECT:-mcpw-0a} -f compose.test.yaml up -d --wait && (TEST_BACKEND=postgres TEST_PG_ADMIN_URL=${TEST_PG_ADMIN_URL:-postgres://postgres:test@localhost:${TEST_PG_PORT:-54329}/postgres} vitest run -c tests/vitest.config.ts --project integration; s=$?; docker compose -p ${TEST_PG_PROJECT:-mcpw-0a} -f compose.test.yaml down -v; exit $s)",
    "ui:dev": "pnpm ui:prep && VITE_API_MOCK=all nuxt dev",
    "ui:build": "pnpm ui:prep && VITE_API_MOCK=all nuxt build",
    "ui:test": "vitest run --config tests/ui/vitest.config.ts",
    "ui:e2e:mock": "pnpm ui:build && playwright test --config tests/ui/playwright.config.ts",
    "ui:e2e:real": "pnpm build && playwright test --config tests/ui/playwright.real.config.ts",
    "ui:e2e": "pnpm ui:e2e:mock && pnpm ui:e2e:real",
    "ui:check": "pnpm typecheck && pnpm lint && pnpm ui:test",
    "ui:prep": "msw init .mocks-public --no-save",
    "ui:check-build": "node tests/ui/check-no-mock.mjs .output"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.17",
    "@better-auth/mcp": "1.7.17",
    "@better-auth/oauth-provider": "1.7.17",
    "@electric-sql/pglite": "0.5.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lucide/vue": "1.68.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@tailwindcss/vite": "4.3.4",
    "@vee-validate/zod": "4.15.1",
    "@vueuse/core": "15.0.0",
    "better-auth": "1.7.17",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "h3": "1.15.11",
    "nodemailer": "10.3.1",
    "nuxt": "4.5.2",
    "pg": "8.23.1",
    "reka-ui": "2.11.0",
    "shadcn-nuxt": "2.9.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "undici": "8.12.3",
    "vee-validate": "4.15.1",
    "vue": "3.5.44",
    "vue-i18n": "11.4.18",
    "vue-router": "5.4.0",
    "vue-sonner": "2.0.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite-tools": "0.4.15",
    "@modelcontextprotocol/node": "2.1.2",
    "@nuxt/eslint-config": "1.17.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "msw": "3.0.3",
    "smtp-server": "3.21.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
