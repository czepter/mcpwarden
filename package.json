{
  "name": "mcpwarden",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "env:init": "sh scripts/init-env.sh",
    "ui:dev": "VITE_API_MOCK=all nuxt dev",
    "ui:build": "VITE_API_MOCK=all nuxt build",
    "ui:test": "vitest run --config tests/ui/vitest.config.ts",
    "ui:e2e": "pnpm ui:build && playwright test --config tests/ui/playwright.config.ts",
    "ui:check": "pnpm typecheck && pnpm lint && pnpm ui:test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lucide/vue": "1.68.0",
    "@tailwindcss/vite": "4.3.4",
    "@vee-validate/zod": "4.15.1",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "nuxt": "4.5.2",
    "reka-ui": "2.11.0",
    "shadcn-nuxt": "2.9.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "vee-validate": "4.15.1",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-sonner": "2.0.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@nuxt/eslint-config": "1.17.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "msw": "3.0.3",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
