{
  // Eigenständig, damit Vitest/oxc für Tests nie eine tsconfig aus einem Elternverzeichnis (z. B. ein anderes Checkout) auflöst.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "#shared/*": ["../shared/*"], "~~/*": ["../*"] }
  },
  "include": ["./**/*", "../server/**/*", "../shared/**/*", "../supervisor/**/*"]
}
