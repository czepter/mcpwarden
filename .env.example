# Create a copy as .env: `pnpm env:init` (generates random values, never overwrites).

# Public URL of the instance. https is required except for localhost.
BASE_URL=http://localhost:3000
# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 32 bytes as Base64 or 64 hex characters. Generate with: openssl rand -base64 32
MASTER_KEY=
# Empty = embedded PGlite in DATA_DIR/pgdata, otherwise postgres://user:pass@host:5432/db
DATABASE_URL=
# Data directory (PGlite). Must be writable.
DATA_DIR=./data
# Comma-separated allowed origins. Empty = origin of BASE_URL.
ALLOWED_ORIGINS=

# Optional: mail sending (currently password reset). Without SMTP_URL no mail is ever sent.
# smtps://user:pass@host:465 (implicit TLS) or smtp://user:pass@host:587 (STARTTLS required, plaintext only to localhost).
# URL-encode special characters in user/password (@ = %40). The value is secret.
SMTP_URL=
# Sender, required when SMTP_URL is set, e.g. mcpwarden <noreply@example.com>
MAIL_FROM=
# Status mails (upstream open/auth_expired/healthy again): minimum spacing per upstream and state in minutes (1 to 10080, default 60).
# MAIL_NOTIFY_WINDOW_MIN=60

# Behind a reverse proxy set true (one hop) or the number of proxies: client IP from X-Forwarded-For (from the right) for the rate limits.
# Leave false without a proxy in front (default): the header is then ignored.
# TRUST_PROXY=false

# For tests only: disable the Better Auth rate limit.
# RATE_LIMIT=off
