# Kopie als .env anlegen: `pnpm env:init` (erzeugt Zufallswerte, überschreibt nie).

# Öffentliche URL der Instanz. https Pflicht außer localhost.
BASE_URL=http://localhost:3000
# Mindestens 32 Zeichen. Erzeugung: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 32 Byte als Base64 oder 64 Hex-Zeichen. Erzeugung: openssl rand -base64 32
MASTER_KEY=
# Leer = eingebettetes PGlite in DATA_DIR/pgdata, sonst postgres://user:pass@host:5432/db
DATABASE_URL=
# Datenverzeichnis (PGlite). Muss beschreibbar sein.
DATA_DIR=./data
# Kommagetrennte erlaubte Origins. Leer = Origin von BASE_URL.
ALLOWED_ORIGINS=

# Optional: Mailversand (derzeit Passwort-Reset). Ohne SMTP_URL wird nie eine Mail versendet.
# smtps://user:pass@host:465 (implizites TLS) oder smtp://user:pass@host:587 (STARTTLS Pflicht, Klartext nur an localhost).
# Sonderzeichen in Benutzer/Passwort URL-kodieren (@ = %40). Der Wert ist geheim.
SMTP_URL=
# Absender, Pflicht wenn SMTP_URL gesetzt ist, z. B. mcpwarden <noreply@example.com>
MAIL_FROM=
# Statusmails (Upstream open/auth_expired/wieder gesund): Mindestabstand je Upstream und Zustand in Minuten (1 bis 10080, Default 60).
# MAIL_NOTIFY_WINDOW_MIN=60

# Hinter einem Reverse-Proxy true (ein Hop) oder Anzahl der Proxys: Client-IP aus X-Forwarded-For (von rechts) fuer die Rate-Limits.
# Ohne Proxy davor false lassen (Default): der Header wird dann ignoriert.
# TRUST_PROXY=false

# Nur für Tests: Better-Auth-Rate-Limit abschalten.
# RATE_LIMIT=off
